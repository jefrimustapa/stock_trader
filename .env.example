# ==========================================
# US Stock Analyst & Trader (STOCK-TRADER)
# Environment Configuration Template
# ==========================================

# Moomoo OpenD Configuration
MOOMOO_OPEND_HOST=moomoo-opend
MOOMOO_OPEND_PORT=11111
MOOMOO_TELNET_PORT=22222
MOOMOO_LOGIN_ACCOUNT=
MOOMOO_LOGIN_PWD_MD5=
# Trading Environment: SIMULATE (Paper Trading) | REAL (Production - Locked)
MOOMOO_TRD_ENV=SIMULATE

# Bridge Security Credentials
# PAPERCLIP_BRIDGE_SECRET: Secret for Paperclip agents communicating via loopback (127.0.0.1:8000)
PAPERCLIP_BRIDGE_SECRET=change-me-to-a-secure-random-token
# BRIDGE_SERVICE_TOKEN: Token for internal services (Dashboard -> Bridge over stock_internal)
BRIDGE_SERVICE_TOKEN=change-me-to-an-internal-service-token

# Authentik SSO Origin Authentication (auth.julietmike.net)
AUTHENTIK_CLIENT_ID=stock-trader
AUTHENTIK_ISSUER_URL=https://auth.julietmike.net/application/o/stock-trader/
AUTHENTIK_JWKS_URL=https://auth.julietmike.net/application/o/stock-trader/jwks/
AUTHENTIK_LOGIN_URL=https://auth.julietmike.net/flows/-/default/authentication/
AUTHENTIK_LOGOUT_URL=/outpost.goauthentik.io/sign_out
# Shared secret injected by NPM forward auth proxy host (anti-spoofing protection)
FORWARD_AUTH_SECRET=change-me-to-a-secure-random-forward-auth-secret
BRIDGE_URL=http://mcp-bridge:8000

# Data Storage
SHARED_DATA_DIR=/app/shared_data

# Network & Ports
# Note: In production host, port 8000 is occupied by Portainer. Default host mapping uses 8005.
BRIDGE_HOST_PORT=8005
DASHBOARD_HOST_PORT=3005
