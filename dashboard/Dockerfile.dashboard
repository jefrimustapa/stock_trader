# Stage 1: Client Builder (Vite + React + MUI SPA)
FROM node:24-alpine AS client-builder
WORKDIR /build
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage 2: Production Express Runner
FROM node:24-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=client-builder /build/dist ./dist
COPY server.js test_dashboard_auth.js test_dashboard_signin.js test_dashboard_qc.js index.html ./

EXPOSE 3000
CMD ["node", "server.js"]
